# ==========================================
# ERPWA Backend - Environment Variables
# ==========================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
# Comma separated list of allowed origins
FRONTEND_URL=http://localhost:3000

# --- Authentication & Security ---
# Generate these using: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=your_jwt_secret_hash_here
ACCESS_TOKEN_SECRET=your_access_token_secret_here
PASSWORD_RESET_TOKEN_SECRET=your_password_reset_secret_here
# Generate using: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/whatsapp_backend"

# --- Third-Party Integrations ---

# Resend (Transactional Emails)
RESEND_API_KEY=re_your_resend_api_key

# Twilio
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- Meta / WhatsApp Business API ---
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
META_APP_ID=your_meta_app_id
META_WA_EMBEDDED_CONFIG_ID=your_meta_embedded_config_id
META_APP_SECRET=your_meta_app_secret
META_SYSTEM_USER_TOKEN=EAASZCF..._your_long_system_user_token
# This must match the callback configured in your Meta Developer Dashboard
META_OAUTH_REDIRECT_URI=https://your-domain.com/api/vendor/whatsapp/embedded-setup

# --- AWS S3 & CloudFront (Storage & Media) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=your_s3_bucket_name
CLOUDFRONT_BASE_URL=https://your_distribution.cloudfront.net

# --- Razorpay (Subscriptions & Billing) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
# The secret used to verify webhook payloads originating from Razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_signature_secret
